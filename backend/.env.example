# Render Backend Environment Variables
# Render supplies PORT automatically. 5050 avoids macOS AirPlay's port 5000 locally.
PORT=5050
NODE_ENV=production
ALLOWED_ORIGIN=https://your-frontend.example.com
ALLOW_IN_MEMORY_FALLBACK=false

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# Session Secret for Admin Authentication
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# Dedicated 32-byte hex key for encrypting the TOTP secret at rest (required before enabling MFA)
MFA_ENCRYPTION_KEY=replace_with_64_hex_characters
MFA_ISSUER=Harsh.dev Admin

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password_at_least_12_characters

# Instant Email Notification Settings (Optional)
# Contact forms prefer the HTTPS provider when RESEND_API_KEY is set.
# Add the key privately in Render. Use an address on your verified sending domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Harsh Portfolio <contact@your-verified-domain.com>
CONTACT_NOTIFY_EMAIL=kumarharsh1851@gmail.com

# Legacy SMTP settings are retained for hosts that permit SMTP and admin OTP mail.
# Render Free blocks Gmail's SMTP ports; use the HTTPS contact provider above.
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
NOTIFY_EMAIL=your_email@gmail.com
