# Render Backend Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Get your free MongoDB connection string at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Secret Key for Admin Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production

# Optional Initial Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
