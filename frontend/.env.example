# Vercel Frontend Environment Variables
# In local development, leave blank to use Vite's proxy to localhost:5050.
# When deployed on Vercel, set this to your Render backend URL e.g. https://code-portfolio-backend.onrender.com
VITE_API_URL=
# Optional: override the local backend address if its PORT is different.
API_PROXY_TARGET=http://127.0.0.1:5050
